@@ -0,0 +1,16 @@
+import datetime
+
+
+def audit_entry(actor, action):
+    stamp = datetime.datetime.utcnow()
+    return {
+        "actor": actor,
+        "action": action,
+        "at": stamp.isoformat() + "Z",
+    }
+
+
+def entry_age_seconds(entry, now=None):
+    now = now or datetime.datetime.utcnow()
+    then = datetime.datetime.fromisoformat(entry["at"].removesuffix("Z"))
+    return (now - then).total_seconds()
