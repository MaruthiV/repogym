+import click
+
+
+def test_format_filename_handles_bytes_without_crashing():
+    result = click.format_filename(b"/reports/output.txt")
+    assert isinstance(result, str)
+
+
+def test_format_filename_handles_bytes_shorten():
+    result = click.format_filename(b"/reports/output.txt", shorten=True)
+    assert isinstance(result, str)
