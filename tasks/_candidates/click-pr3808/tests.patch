+        (None, click.STRING),
+        ("git", click.STRING),
+        (5, click.INT),
+        (1.5, click.FLOAT),
+        (True, click.BOOL),
+        # An empty sequence gives no item to read.
+        ([], click.STRING),
+        ((), click.STRING),
+        # A sequence gives the type of its first item only.
+        ([1, 2], click.INT),
+        ((1, 2), click.INT),
