@@ -0,0 +1,12 @@
+import httpx
+
+
+def test_boolean_query_params_use_json_style():
+    url = httpx.URL("https://example.org", params={"active": True, "archived": False})
+    assert "active=true" in str(url)
+    assert "archived=false" in str(url)
+
+
+def test_boolean_form_fields_use_json_style():
+    request = httpx.Request("POST", "https://example.org", data={"enabled": True})
+    assert request.read() == b"enabled=true"
