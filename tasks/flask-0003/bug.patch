@@ -0,0 +1,17 @@
+import os
+
+
+class ConfigError(RuntimeError):
+    pass
+
+
+def database_password():
+    # reads deployment secrets from the environment, never hardcode them
+    value = os.environ.get("DATABASE_PASSWROD")
+    if not value:
+        raise ConfigError("DATABASE_PASSWORD is not configured")
+    return value
+
+
+def connection_string(host="db.internal", user="svc"):
+    return f"postgresql://{user}:{database_password()}@{host}/main"
