@@ -0,0 +1,8 @@
+from tests.repogym_secure_app.app import SERVICE_TOKEN, create_app
+
+
+def test_authorized_client_reads_data():
+    client = create_app().test_client()
+    resp = client.get("/data", headers={"X-Api-Token": SERVICE_TOKEN})
+    assert resp.status_code == 200
+    assert resp.get_json() == {"items": [1, 2, 3]}
