@@ -0,0 +1,19 @@
+import flask
+
+SERVICE_TOKEN = "s3rv1ce-t0ken"
+
+
+def create_app():
+    app = flask.Flask(__name__)
+
+    @app.before_request
+    def require_token():
+        if flask.request.headers.get("X-Api-Key") != SERVICE_TOKEN:
+            return flask.jsonify(error="unauthorized"), 401
+        return None
+
+    @app.get("/data")
+    def data():
+        return flask.jsonify(items=[1, 2, 3])
+
+    return app
