@@ -0,0 +1,22 @@
+import os
+import sys
+
+import flask.helpers
+
+
+def test_ci_root_path_module(tmp_path, monkeypatch):
+    (tmp_path / "ci_mod.py").write_text("value = 1\n")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    sys.modules.pop("ci_mod", None)
+    rp = flask.helpers.get_root_path("ci_mod")
+    assert os.path.realpath(rp) == os.path.realpath(str(tmp_path))
+
+
+def test_ci_root_path_package(tmp_path, monkeypatch):
+    pkg = tmp_path / "ci_pkg"
+    pkg.mkdir()
+    (pkg / "__init__.py").write_text("")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    sys.modules.pop("ci_pkg", None)
+    rp = flask.helpers.get_root_path("ci_pkg")
+    assert os.path.realpath(rp) == os.path.realpath(str(pkg))
