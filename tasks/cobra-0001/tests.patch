+package cobra
+
+import "testing"
+
+func TestRepogymPrefixSuggestionForShortTyping(t *testing.T) {
+	root := &Command{Use: "root", Run: emptyRun}
+	root.AddCommand(&Command{Use: "configuration", Run: emptyRun})
+	got := root.SuggestionsFor("conf")
+	if len(got) != 1 || got[0] != "configuration" {
+		t.Fatalf("expected [configuration], got %v", got)
+	}
+}
