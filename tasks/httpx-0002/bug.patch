@@ -0,0 +1,21 @@
+import httpx
+
+from tests.repogym_fetch.fetcher import fetch_json
+
+
+def flaky_transport(failures):
+    state = {"calls": 0}
+
+    def handler(request):
+        state["calls"] += 1
+        if state["calls"] <= failures:
+            return httpx.Response(503, json={"error": "unavailable"})
+        return httpx.Response(200, json={"ok": True})
+
+    return httpx.MockTransport(handler), state
+
+
+def test_fetch_json_survives_transient_503s():
+    transport, _ = flaky_transport(failures=2)
+    client = httpx.Client(transport=transport)
+    assert fetch_json("https://upstream.internal/api", client=client) == {"ok": True}
