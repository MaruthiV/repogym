@@ -0,0 +1,16 @@
+import io
+
+import httpx
+from httpx._utils import peek_filelike_length
+
+
+def test_peek_filelike_length_preserves_position():
+    stream = io.BytesIO(b"hello world")
+    stream.seek(3)
+    assert peek_filelike_length(stream) == 11
+    assert stream.tell() == 3
+
+
+def test_request_content_from_bytesio_body():
+    request = httpx.Request("POST", "http://example.org", content=io.BytesIO(b"payload"))
+    assert request.read() == b"payload"
