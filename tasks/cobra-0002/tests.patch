+package cobra
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestRepogymAliasInvocation(t *testing.T) {
+	root := &Command{Use: "root", Run: emptyRun}
+	called := false
+	deploy := &Command{
+		Use:     "deploy",
+		Aliases: []string{"ship", "release"},
+		Run:     func(cmd *Command, args []string) { called = true },
+	}
+	root.AddCommand(deploy)
+
+	buf := new(bytes.Buffer)
+	root.SetOut(buf)
+	root.SetErr(buf)
+	root.SetArgs([]string{"ship"})
+	if err := root.Execute(); err != nil {
+		t.Fatalf("alias invocation errored: %v (output: %s)", err, buf.String())
+	}
+	if !called {
+		t.Fatal("deploy command was not run via its alias")
+	}
+}
